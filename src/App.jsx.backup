function scrollInto(id) {
  const node = document.getElementById(id);
  if (node) {
    node.scrollIntoView({ behavior: "smooth", block: "start" });
  }
}

export default function App() {
  const [activeSection, setActiveSection] = useState("home");

  useEffect(() => {
    const observer = new IntersectionObserver(
      (entries) => {
        const visibleEntry = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

        if (visibleEntry?.target?.id) {
          setActiveSection(visibleEntry.target.id);
        }
      },
      { threshold: [0.2, 0.35, 0.5, 0.7] }
    );

    navigation.forEach((item) => {
      const element = document.getElementById(item.id);
      if (element) observer.observe(element);
    });

    return () => observer.disconnect();
  }, []);

  return (
    <div className="studio-page">
      <header className="studio-nav">
        <button className="studio-brand" onClick={() => scrollInto("home")}>
          Dhanush Studio
        </button>
        <nav className="studio-links" aria-label="Main navigation">
          {navigation.map((item) => (
            <button
              key={item.id}
              className={`studio-link ${activeSection === item.id ? "is-active" : ""}`}
              onClick={() => scrollInto(item.id)}
            >
              {item.label}
            </button>
          ))}
        </nav>
      </header>

      <main>
        <section className="studio-hero" id="home">
          <div className="studio-hero__copy">
            <p className="studio-kicker">Award-winning digital experience portfolio</p>
            <h1 className="studio-title">
              Product-grade interfaces built with a studio mindset.
            </h1>
            <p className="studio-intro">
              I design and build clean, high-contrast web experiences using the career data already present in this portfolio. The presentation is now reworked into a more cinematic, editorial layout.
            </p>

            <div className="studio-hero__actions">
              <button className="studio-button studio-button--primary" onClick={() => scrollInto("work")}>
                View selected work
              </button>
              <button
                className="studio-button studio-button--ghost"
                onClick={() => {
                  const link = document.createElement("a");
                  link.href = resume;
                  link.download = "Dhanush_Resume.pdf";
                  document.body.appendChild(link);
                  link.click();
                  document.body.removeChild(link);
                }}
              >
                Download resume
              </button>
            </div>

            <div className="studio-stats">
              {keyStats.map((item) => (
                <article className="studio-stat" key={item.label}>
                  <span className="studio-stat__value">{item.value}</span>
                  <span className="studio-stat__label">{item.label}</span>
                </article>
              ))}
            </div>
          </div>

          <div className="studio-hero__visual">
            <div className="portrait-shell">
              <div className="portrait-ring portrait-ring--outer"></div>
              <div className="portrait-ring portrait-ring--inner"></div>
              <img src={profilePic} alt="Dhanush" className="portrait-image" />
            </div>

            <div className="studio-meta-card">
              <span className="studio-meta-card__eyebrow">Strategy · Design · Engineering</span>
              <p>
                Building compact, direct interfaces with better hierarchy, stronger contrast, and less noise.
              </p>
            </div>
          </div>
        </section>

        <section className="studio-strip">
          <div className="studio-strip__label">Trusted by the work</div>
          <div className="studio-strip__track" aria-label="capability tags">
            {[...capabilityTags, ...capabilityTags].map((tag, index) => (
              <span className="studio-chip" key={`${tag}-${index}`}>
                {tag}
              </span>
            ))}
          </div>
        </section>

        <section className="studio-section" id="work">
          <div className="studio-section__header">
            <p className="studio-section__eyebrow">Selected work</p>
            <h2>Deep dives into the portfolio.</h2>
            <p>
              The projects stay the same. The framing changes into a more studio-like rail with stronger focus on the narrative of each build.
            </p>
          </div>

          <div className="work-rail" aria-label="selected projects">
            {projectCards.map((project) => (
              <article className="work-card" key={project.number}>
                <div className="work-card__topline">
                  <span>{project.number}</span>
                  <span>{project.eyebrow}</span>
                </div>
                <h3>{project.title}</h3>
                <p>{project.summary}</p>
                <div className="work-card__points">
                  {project.points.map((point) => (
                    <span key={point}>{point}</span>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </section>

        <section className="studio-section" id="capabilities">
          <div className="studio-section__header">
            <p className="studio-section__eyebrow">Capabilities</p>
            <h2>How the portfolio is built.</h2>
            <p>
              This keeps the current skill data but presents it in a more editorial, less component-heavy format.
